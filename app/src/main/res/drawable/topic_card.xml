<?xml version="1.0" encoding="utf-8"?>

<android.support.v7.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginBottom="10dp"

    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Topic number -->
        <TextView
            android:id="@+id/topic_number"
            android:layout_width="38dp"
            android:layout_height="38dp"

            android:gravity="center"

            android:text="01"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"

            android:background="@drawable/topic_number" />


        <!-- Main content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:layout_marginStart="12dp"

            android:orientation="vertical">

            <!-- Title -->
            <TextView
                android:id="@+id/topic_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Introduction to Java"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#222222"

                android:maxLines="1"
                android:ellipsize="end" />


            <!-- Goal -->
            <TextView
                android:id="@+id/topic_goal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="4dp"

                android:text="Understand what Java is and how Java programs work."
                android:textSize="12sp"
                android:textColor="#777777"

                android:maxLines="2"
                android:ellipsize="end" />


            <!-- Resources -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="9dp"

                android:orientation="horizontal">

                <TextView
                    android:id="@+id/topic_video"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="▶ Video"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#582633" />


                <TextView
                    android:id="@+id/topic_document"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="15dp"

                    android:text="▣ Document"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#582633" />


                <TextView
                    android:id="@+id/topic_quiz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="15dp"

                    android:text="✓ Quiz"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#582633" />

            </LinearLayout>

        </LinearLayout>


        <!-- Completion indicator -->
        <TextView
            android:id="@+id/topic_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_gravity="center_vertical"

            android:text="›"
            android:textSize="26sp"
            android:textColor="#999999" />

    </LinearLayout>

</android.support.v7.widget.CardView>
