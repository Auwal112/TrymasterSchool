<?xml version="1.0" encoding="utf-8"?>

<android.support.v7.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="250dp"
    android:layout_height="190dp"

    android:layout_marginEnd="8dp"

    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Course category / label -->
        <TextView
            android:id="@+id/course_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="COURSE"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="#777777" />


        <!-- Course title -->
        <TextView
            android:id="@+id/course_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="5dp"

            android:text="Java Programming"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#222222"

            android:maxLines="1"
            android:ellipsize="end" />


        <!-- Description -->
        <TextView
            android:id="@+id/course_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="5dp"

            android:text="Learn the fundamentals of Java programming."
            android:textSize="12sp"
            android:textColor="#777777"

            android:maxLines="2"
            android:ellipsize="end" />


        <!-- Progress percentage -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="7dp"

            android:orientation="horizontal">

            <TextView
                android:id="@+id/course_progress_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:text="35% complete"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#555555" />

            <TextView
                android:id="@+id/course_topics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="5 topics"
                android:textSize="11sp"
                android:textColor="#777777" />

        </LinearLayout>


        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/course_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"

            android:layout_width="match_parent"
            android:layout_height="6dp"

            android:layout_marginTop="5dp"

            android:max="100"
            android:progress="90" />


        

    </LinearLayout>

</android.support.v7.widget.CardView>

